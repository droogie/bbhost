// The Windows exe's icon, manifest and version details. Explorer shows the
// first icon; SDL gives its windows (the setup window and the game's) the
// same one.
#include "bbhost_version.h"

1 ICON "bbhost.ico"

// The manifest (CREATEPROCESS_MANIFEST_RESOURCE_ID, RT_MANIFEST): UTF-8 as
// the process's code page.
1 24 "bbhost.manifest"

// VS_VERSION_INFO, VOS_NT_WINDOWS32 and VFT_APP from winver.h.
1 VERSIONINFO
FILEVERSION BBHOST_VERSION_NUMBERS,0
PRODUCTVERSION BBHOST_VERSION_NUMBERS,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "bbhost"
            VALUE "ProductName", "bbhost"
            VALUE "FileVersion", BBHOST_VERSION
            VALUE "ProductVersion", BBHOST_VERSION
            VALUE "InternalName", "bbhost"
            VALUE "OriginalFilename", "bbhost.exe"
            VALUE "LegalCopyright", "GNU General Public License, version 3 or later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
